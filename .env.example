# God Eyes - MultiModal AI System Configuration
# Copy this file to .env and fill in your actual API keys

######### SYSTEM CONFIG #########
# Comma-separated list of providers to enable
PROVIDERS=openrouter

######### OPENROUTER CONFIG #########
# OpenRouter API key (get from https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# OpenRouter API base URL
BASE_URL=https://openrouter.ai/api/v1

# Language model for text generation
# Examples: 
#   - minimax/minimax-m2:free
#   - anthropic/claude-3-haiku
#   - openai/gpt-3.5-turbo
LLM_MODEL_NAME=minimax/minimax-m2:free

# Vision-Language model for image analysis
# Examples:
#   - nvidia/nemotron-nano-12b-v2-vl:free
#   - anthropic/claude-3-sonnet
#   - openai/gpt-4-vision-preview
VLM_MODEL_NAME=nvidia/nemotron-nano-12b-v2-vl:free

######### OPENAI CONFIG (Optional) #########
# OpenAI API key (get from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_ORG_ID=org-your-organization-id (optional)

######### ANTHROPIC CONFIG (Optional) #########
# Anthropic API key (get from https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

######### GOOGLE IMAGE SEARCH CONFIG #########
# Google Custom Search API key (get from https://console.cloud.google.com/apis/credentials)
# Steps to get API key:
# 1. Go to Google Cloud Console
# 2. Enable "Custom Search API"
# 3. Create credentials (API key)
GOOGLE_SEARCH_ENGINE_KEY=AIzaSy-your-google-api-key-here

# Google Custom Search Engine ID (get from https://programmablesearchengine.google.com/)
# Steps to get Search Engine ID:
# 1. Create a programmable search engine
# 2. Enable "Image Search"
# 3. Copy the Search Engine ID (cx parameter)
GOOGLE_ID_CSE=your-custom-search-engine-id

######### GOOGLE GEMINI CONFIG (Optional) #########
# Google AI Studio API key for Gemini models
# GOOGLE_AI_API_KEY=AIzaSy-your-gemini-api-key-here

######### COHERE CONFIG (Optional) #########
# Cohere API key (get from https://dashboard.cohere.com/api-keys)
# COHERE_API_KEY=your-cohere-api-key-here

######### MODEL SETTINGS #########
# Default temperature for model responses (0.0 - 2.0)
# Lower = more focused, Higher = more creative
TEMPERATURE=0.7

# Maximum tokens in model response
MAX_TOKENS=1024

# Request timeout in seconds
TIMEOUT=30

######### ADVANCED SETTINGS (Optional) #########
# Enable debug logging
# DEBUG=false

# Custom model endpoints
# CUSTOM_API_ENDPOINT=http://localhost:8000

# Retry settings
# MAX_RETRIES=3
# RETRY_DELAY=1

######### JUPYTER NOTEBOOK SETTINGS #########
# Python path for notebooks (usually auto-detected)
# PYTHONPATH=/path/to/god-eyes
